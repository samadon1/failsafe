# Copy to .env and fill in. NEVER commit real keys — .env is gitignored; this file is placeholders.

# --- LLM: Nemotron proposes candidate configurations in the search (Phase 4, D-035) ---
# Develop on NVIDIA Build (free, no billing form); submission runs go via Nebius Token Factory —
# a single base-url swap, same model id. Key resolves FAILSAFE_LLM_API_KEY, then NEBIUS_API_KEY,
# then NVIDIA_API_KEY.
FAILSAFE_LLM_API_KEY=
FAILSAFE_LLM_BASE_URL=https://integrate.api.nvidia.com/v1   # Token Factory: https://api.tokenfactory.nebius.com/v1
FAILSAFE_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- VLM cloud confirmer (D-049): a real NVIDIA multimodal reasoner confirms detections ---
# Hosted Nemotron-omni by default. To use Cosmos Reason, run its NIM on a GPU node and point here:
#   FAILSAFE_VLM_BASE_URL=http://<gpu-host>:8000/v1   FAILSAFE_VLM_MODEL=nvidia/cosmos3-nano-reasoner
FAILSAFE_VLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
FAILSAFE_VLM_BASE_URL=
FAILSAFE_VLM_API_KEY=            # falls back to FAILSAFE_LLM_API_KEY / NVIDIA_API_KEY

# --- Legacy fallback names (still honoured) ---
NVIDIA_API_KEY=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_MODEL=

# --- Nebius Serverless Jobs executor (D-036), used only by `failsafe campaign --executor nebius` ---
NEBIUS_FAILSAFE_IMAGE=          # e.g. cr.nebius.cloud/<registry>/failsafe:latest
NEBIUS_PLATFORM=gpu-l40s-a
NEBIUS_PRESET=1gpu-8vcpu-32gb
NEBIUS_TIMEOUT=1h
NEBIUS_RESULTS_URI=             # S3-compatible bucket for synced results
